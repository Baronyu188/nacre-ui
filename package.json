{
  "name": "@nacre-ui/react",
  "version": "0.2.0",
  "description": "Reusable React components for restrained liquid-glass interfaces.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Baronyu188/nacre-ui.git"
  },
  "homepage": "https://github.com/Baronyu188/nacre-ui#readme",
  "keywords": [
    "react",
    "ui",
    "liquid-glass",
    "react-aria",
    "motion"
  ],
  "type": "module",
  "main": "./dist-lib/index.js",
  "module": "./dist-lib/index.js",
  "types": "./dist-lib/types/index.d.ts",
  "style": "./dist-lib/nacre.css",
  "files": [
    "dist-lib",
    "public/nacre-icon.png",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist-lib/types/index.d.ts",
      "import": "./dist-lib/index.js",
      "default": "./dist-lib/index.js"
    },
    "./styles.css": "./dist-lib/nacre.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "check": "tsc -b --pretty false",
    "prepare": "npm run build:lib",
    "verify:package": "node scripts/verify-exports.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.3",
    "motion": "^13.1.1",
    "react-aria-components": "^1.20.0"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  }
}
